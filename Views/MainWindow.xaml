<Window x:Class="HelpDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Главное окно"
        Height="720" Width="1120"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HelpDesk" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Система обработки заявок" Foreground="#C9DCF0" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentUserText" Text="Пользователь: admin"
                               Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Выйти" Style="{StaticResource HeaderButton}" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель поиска и действий -->
        <Border Grid.Row="1" Margin="16,14,16,0" Background="White"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Поиск:" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" Margin="2,0,8,0"/>

                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource InputBox}" KeyDown="SearchTextBox_KeyDown"/>
                    <TextBlock Text="Введите текст для поиска" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               FontSize="12" Foreground="#9AA5B1">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Column="2" Text="Статус:" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" Margin="14,0,8,0"/>

                <ComboBox x:Name="StatusComboBox" Grid.Column="3" Style="{StaticResource InputCombo}"
                          SelectedIndex="0" SelectionChanged="StatusComboBox_SelectionChanged">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="Новая"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Выполнена"/>
                    <ComboBoxItem Content="Отклонена"/>
                </ComboBox>

                <Button Grid.Column="4" Content="Найти" Style="{StaticResource PrimaryButton}"
                        Margin="12,0,0,0" Click="SearchButton_Click"/>
                <Button Grid.Column="5" Content="Сбросить" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Click="ResetFilterButton_Click"/>

                <Button x:Name="AddTicketButton" Grid.Column="7" Content="Добавить"
                        Style="{StaticResource PrimaryButton}" Margin="0" Click="AddTicketButton_Click"/>
                <Button x:Name="EditTicketButton" Grid.Column="8" Content="Изменить"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="EditTicketButton_Click"/>
                <Button x:Name="DeleteTicketButton" Grid.Column="9" Content="Удалить"
                        Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="DeleteTicketButton_Click"/>
            </Grid>
        </Border>

        <!-- Список заявок -->
        <Border Grid.Row="2" Margin="16,12,16,8" Background="White"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="18,14,18,10">
                    <TextBlock Text="Список заявок" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="CountText" Text="Показано заявок: 0 из 0"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </Grid>

                <DataGrid x:Name="TicketsGrid" Grid.Row="1" Margin="18,0,18,16"
                          Style="{StaticResource TicketsGrid}"
                          MouseDoubleClick="TicketsGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="48"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="165"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="105"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="115"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="95"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Строка состояния -->
        <Border Grid.Row="3" Background="#EAF1F8">
            <Grid Margin="24,0">
                <TextBlock x:Name="StatusText" Text="Готово" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="HelpDesk 1.0" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
