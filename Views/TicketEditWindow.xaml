<Window x:Class="HelpDesk.Views.TicketEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Редактирование заявки"
        Height="580" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Segoe UI">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Редактирование заявки" FontSize="22" FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryBrush}"/>
        <TextBlock x:Name="NumberText" Grid.Row="1" Text="Заявка №" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/>

        <TextBlock Grid.Row="2" Text="Категория" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="3" Style="{StaticResource InputCombo}" Height="36">
            <ComboBoxItem Content="Оборудование"/>
            <ComboBoxItem Content="Программное обеспечение"/>
            <ComboBoxItem Content="Сеть"/>
            <ComboBoxItem Content="Учётная запись"/>
            <ComboBoxItem Content="Периферия"/>
            <ComboBoxItem Content="Другое"/>
        </ComboBox>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="Описание проблемы" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="DescriptionTextBox" Style="{StaticResource InputBox}"
                     Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" Padding="8,7"/>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Приоритет" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="PriorityComboBox" Style="{StaticResource InputCombo}" Height="36">
                    <ComboBoxItem Content="Низкий"/>
                    <ComboBoxItem Content="Средний"/>
                    <ComboBoxItem Content="Высокий"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Статус" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="StatusComboBox" Style="{StaticResource InputCombo}" Height="36">
                    <ComboBoxItem Content="Новая"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Выполнена"/>
                    <ComboBoxItem Content="Отклонена"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="8" Foreground="#C0392B" FontSize="12"
                   VerticalAlignment="Bottom" Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Width="110"
                    Margin="0,0,10,0" IsCancel="True" Click="CancelButton_Click"/>
            <Button Content="Сохранить изменения" Style="{StaticResource PrimaryButton}" Width="180"
                    IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
