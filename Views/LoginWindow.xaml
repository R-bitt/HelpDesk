<Window x:Class="HelpDesk.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk — Авторизация"
        Height="440" Width="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI">
    <Grid>
        <Border Height="6" VerticalAlignment="Top" Background="{StaticResource PrimaryBrush}"/>

        <StackPanel Margin="40,42,40,28">
            <TextBlock Text="HelpDesk"
                       FontSize="30" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Система обработки заявок"
                       FontSize="13" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,30"/>

            <TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="LoginTextBox" Style="{StaticResource InputBox}" Height="38"/>

            <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPassword}" Height="38"/>

            <TextBlock x:Name="ErrorText" Foreground="#C0392B" FontSize="12"
                       Margin="0,10,0,0" Visibility="Collapsed"/>

            <Button x:Name="LoginButton" Content="Войти"
                    Style="{StaticResource PrimaryButton}"
                    Height="42" Margin="0,18,0,0"
                    IsDefault="True"
                    Click="LoginButton_Click"/>

            <TextBlock Text="Введите учётные данные для входа в систему"
                       FontSize="11" Foreground="#9AA5B1"
                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
    </Grid>
</Window>
